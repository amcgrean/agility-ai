OPENAI_API_KEY=your_openai_api_key_here
CHAT_MODEL=gpt-5-mini
EMBED_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K_CANDIDATES=10
FINAL_TOP_K=4
MAX_CONTEXT_CHARS=9000
MIN_RERANK_SCORE=0.1
MAX_RECENT_MESSAGES=6
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
MAX_OUTPUT_TOKENS=700
REQUEST_CACHE_TTL_SECONDS=300
CACHE_DB_FILE=./agility_cache.db
ENABLE_DEBUG_MODE=false
ENABLE_HYBRID_RETRIEVAL_HINT=true
OPENAI_REASONING_EFFORT=minimal
OPENAI_TEXT_VERBOSITY=medium
INPUT_COST_PER_MILLION=0.25
OUTPUT_COST_PER_MILLION=2.0
LOG_LEVEL=INFO
ADMIN_EXPORT_TOKEN=replace_with_secure_token_if_using_exports
TRAINING_EXPORT_SALT=replace_with_random_salt_if_using_exports
EXPERT_USER_IDENTITIES=expert@example.com
STAFF_USER_IDENTITIES=staff@example.com
